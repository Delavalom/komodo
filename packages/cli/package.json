{
  "name": "komodo-review",
  "version": "0.6.0",
  "description": "AI code review on your own Claude or ChatGPT subscription. CodeRabbit-class reviews, $0/seat.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Delavalom/komodo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delavalom/komodo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Delavalom/komodo/issues"
  },
  "keywords": [
    "code-review",
    "ai",
    "pull-request",
    "claude",
    "codex",
    "github"
  ],
  "bin": {
    "komodo-review": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-web.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo 'no tests'",
    "prepack": "node scripts/bundle-web.mjs --require"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "commander": "^13.0.0",
    "picocolors": "^1.1.0",
    "picomatch": "^4.0.2",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@komodo/core": "workspace:*",
    "@komodo/ingest": "workspace:*",
    "@komodo/store": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
